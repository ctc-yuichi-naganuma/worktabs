# Editors that read this match the project's style without being told.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# A Markdown line break can be two trailing spaces.
[*.md]
trim_trailing_whitespace = false

# cmd.exe misreads batch files with LF line endings (.gitattributes).
[*.cmd]
end_of_line = crlf

[*.cs]
indent_size = 4
